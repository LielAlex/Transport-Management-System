<Page x:Class="TransportManagementSystem.Pages.VehiclesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Vehicles">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDE ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- title -->
                <RowDefinition Height="Auto"/>
                <!-- form -->
                <RowDefinition Height="Auto"/>
                <!-- buttons -->
                <RowDefinition Height="*"/>
                <!-- grid -->
            </Grid.RowDefinitions>

            <!-- TITLE -->
            <TextBlock Grid.Row="0"
                       Text="Manage Vehicles"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#2B579A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>

            <!-- FORM (2 lignes) -->
            <Grid Grid.Row="1" Margin="10,0,10,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                    <TextBlock Text="Licence Plate" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtPlate" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                    <TextBlock Text="Mark" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbMark" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,10">
                    <TextBlock Text="Model" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtModel" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,12,10">
                    <TextBlock Text="Vehicle Year" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbYear" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                    <TextBlock Text="Engine Type" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbEngineType" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Row 1 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Booked" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbBooked" Height="28" Margin="0,6,0,0">
                        <ComboBoxItem Content="No"/>
                        <ComboBoxItem Content="Yes"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Type" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbType" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Mileage" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtMileage" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="Color" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtColor" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="4">
                    <TextBlock Text="Driver" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbDriver" Height="28" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- BUTTONS -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">

                <Button Content="Save"
                        Width="120"
                        Height="36"
                        Margin="8,0"
                        Background="#F6C000"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnSave_Click"/>

                <Button Content="Edit"
                        Width="120"
                        Height="36"
                        Margin="8,0"
                        Background="#0A7B34"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnEdit_Click"/>

                <Button Content="Delete"
                        Width="120"
                        Height="36"
                        Margin="8,0"
                        Background="#E0007A"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnDelete_Click"/>
            </StackPanel>

            <!-- DATAGRID -->
            <DataGrid Grid.Row="3"
                      x:Name="GridVehicles"
                      Margin="10"
                      AutoGenerateColumns="True"
                      SelectionChanged="GridVehicles_SelectionChanged"/>
        </Grid>

        <!-- ================= RIGHT SIDE (RESUME) ================= -->
        <Border Grid.Column="1"
                Margin="10,0,0,0"
                Background="#F3F5F7"
                CornerRadius="12"
                Padding="14">
            <StackPanel HorizontalAlignment="Center">

                <Grid Width="160" Height="160" Margin="0,10,0,18">
                    <Ellipse Stroke="#1E63D5" StrokeThickness="18" Fill="White"/>
                    <TextBlock Text="Resume"
                               Foreground="Crimson"
                               FontWeight="Bold"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Travels"
                           Foreground="Goldenrod"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Num"
                           Foreground="Crimson"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>