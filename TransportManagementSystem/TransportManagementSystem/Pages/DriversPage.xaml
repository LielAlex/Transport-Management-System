<Page x:Class="TransportManagementSystem.Pages.DriversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Drivers">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITRE -->
        <TextBlock Grid.Row="0"
                   Text="Manage Drivers"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#2B579A"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18"/>

        <!-- FORMULAIRE -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Col 0 -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Driver Name" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtDriverName" Height="28" Margin="0,6,0,10"/>

                <TextBlock Text="Driver DOB" FontWeight="SemiBold"/>
                <DatePicker x:Name="DpDob" Height="28" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Col 1 -->
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Driver Name" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbDrivers" Height="28" Margin="0,6,0,10"/>

                <TextBlock Text="Join Date" FontWeight="SemiBold"/>
                <DatePicker x:Name="DpJoinDate" Height="28" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Col 2 -->
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="Driver Phone" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtPhone" Height="28" Margin="0,6,0,10"/>

                <TextBlock Text="Gender" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbGender" Height="28" Margin="0,6,0,0">
                    <ComboBoxItem Content="Male"/>
                    <ComboBoxItem Content="Female"/>
                </ComboBox>
            </StackPanel>

            <!-- Col 3 -->
            <StackPanel Grid.Column="3">
                <TextBlock Text="Driver Address" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtAddress" Height="80" Margin="0,6,0,0"
                         AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- BOUTONS -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Save" Width="120" Height="36" Margin="8,0"
                    Background="#F6C000" Foreground="White" FontWeight="Bold"
                    Click="BtnSave_Click"/>

            <Button Content="Edit" Width="120" Height="36" Margin="8,0"
                    Background="#0A7B34" Foreground="White" FontWeight="Bold"
                    Click="BtnEdit_Click"/>

            <Button Content="Fire" Width="120" Height="36" Margin="8,0"
                    Background="#E0007A" Foreground="White" FontWeight="Bold"
                    Click="BtnFire_Click"/>
        </StackPanel>

        <!-- Zone libre (table / liste des drivers par ex.) -->
        <Grid Grid.Row="3">
            <DataGrid x:Name="GridDrivers" AutoGenerateColumns="True" />
        </Grid>
    </Grid>
</Page>