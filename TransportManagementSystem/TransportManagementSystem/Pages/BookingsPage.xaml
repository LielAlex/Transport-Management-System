<Page x:Class="TransportManagementSystem.Pages.BookingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Bookings">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- ====== PARTIE GAUCHE : FORMULAIRE ====== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <TextBlock Grid.Row="0"
                       Text="Bookings"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#2B579A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>

            <!-- Formulaire -->
            <Grid Grid.Row="1" Margin="10,0,10,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Col 0 : Customer -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Customer" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbCustomer" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Col 1 : Vehicle + Amount -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Vehicle" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbVehicle" Height="28" Margin="0,6,0,10"/>

                    <TextBlock Text="Amount" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtAmount" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Col 2 : Driver + Return Date -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Driver" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtDriver" Height="28" Margin="0,6,0,10"/>

                    <TextBlock Text="Return Date" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DpReturnDate" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Col 3 : Pickup Date -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Pickup Date" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DpPickupDate" Height="28" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Boutons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="Save" Width="120" Height="36" Margin="8,0"
                        Background="#F6C000" Foreground="White" FontWeight="Bold"
                        Click="BtnSave_Click"/>

                <Button Content="Edit" Width="120" Height="36" Margin="8,0"
                        Background="#0A7B34" Foreground="White" FontWeight="Bold"
                        Click="BtnEdit_Click"/>

                <Button Content="Fire" Width="120" Height="36" Margin="8,0"
                        Background="#E0007A" Foreground="White" FontWeight="Bold"
                        Click="BtnFire_Click"/>
            </StackPanel>
        </Grid>

        <!-- ====== PARTIE DROITE : RESUME ====== -->
        <Border Grid.Column="1" Margin="10,0,0,0"
                Background="#F3F5F7" CornerRadius="12" Padding="14">

            <StackPanel HorizontalAlignment="Center">

                <!-- Cercle "Resume" -->
                <Grid Width="170" Height="170" Margin="0,10,0,18">
                    <Ellipse Stroke="#1E63D5" StrokeThickness="18" Fill="White"/>
                    <TextBlock Text="Resume"
                               Foreground="Crimson"
                               FontWeight="Bold"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Textes -->
                <TextBlock Text="Travels"
                           Foreground="Goldenrod"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Num"
                           Foreground="Crimson"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Stars"
                           Foreground="Goldenrod"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="5"
                           Foreground="Crimson"
                           FontWeight="Bold"
                           FontSize="22"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Excellent"
                           Foreground="Crimson"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>
        </Border>

    </Grid>
</Page>