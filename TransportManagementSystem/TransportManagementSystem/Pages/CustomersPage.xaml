<Page x:Class="TransportManagementSystem.Pages.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Customers">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDE ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE -->
            <TextBlock Text="Manage Customers"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#2B579A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- FORM -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Customer Name -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Customer Name" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtCustName" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Gender -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Gender" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbGender" Height="28" Margin="0,6,0,0">
                        <ComboBoxItem Content="Male"/>
                        <ComboBoxItem Content="Female"/>
                    </ComboBox>
                </StackPanel>

                <!-- Phone -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Customer Phone" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtPhone" Height="28" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Address -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Customer Address" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtAddress"
                             Height="70"
                             Margin="0,6,0,0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- BUTTONS -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10">

                <Button Content="Save"
                        Width="120"
                        Height="36"
                        Margin="8"
                        Background="#F6C000"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnSave_Click"/>

                <Button Content="Edit"
                        Width="120"
                        Height="36"
                        Margin="8"
                        Background="#0A7B34"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnEdit_Click"/>

                <Button Content="Delete"
                        Width="120"
                        Height="36"
                        Margin="8"
                        Background="#E0007A"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnDelete_Click"/>
            </StackPanel>

            <!-- DATAGRID -->
            <DataGrid Grid.Row="3"
                      x:Name="GridCustomers"
                      Margin="10"
                      AutoGenerateColumns="True"
                      SelectionChanged="GridCustomers_SelectionChanged"/>
        </Grid>

        <!-- ================= RIGHT SIDE (RESUME) ================= -->
        <Border Grid.Column="1"
                Margin="10,0,0,0"
                Background="#F3F5F7"
                CornerRadius="12"
                Padding="14">

            <StackPanel HorizontalAlignment="Center">

                <Grid Width="160" Height="160" Margin="0,10,0,18">
                    <Ellipse Stroke="#1E63D5"
                             StrokeThickness="18"
                             Fill="White"/>
                    <TextBlock Text="Resume"
                               Foreground="Crimson"
                               FontWeight="Bold"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Bookings"
                           Foreground="Goldenrod"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Num"
                           Foreground="Crimson"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Income"
                           Foreground="Goldenrod"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Amount"
                           Foreground="Green"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>